{
  "name": "keep-me-update",
  "version": "1.1.0",
  "author": "Nemocccc",
  "license": "MIT",
  "description": "Daily newspaper with sourced news and evidence-based trend/opportunity analysis; HTML, Markdown and local cron.",
  "homepage": "https://github.com/Nemocccc/KeepMeUpdate",
  "openclaw": {
    "compat": {
      "pluginApi": "1.0",
      "skillFormat": "hermes"
    }
  },
  "config": {
    "file": "~/.config/keep-me-update/config.json",
    "example": "config.example.json"
  },
  "dependencies": {
    "python": ">=3.9",
    "optional_commands": [
      "codex (required for scheduled editing)",
      "crontab (local scheduling)",
      "notify-send (desktop notification)"
    ]
  },
  "requirements": {
    "api_keys": [],
    "environment_variables": [],
    "system_packages": [],
    "pip_packages": []
  }
}
